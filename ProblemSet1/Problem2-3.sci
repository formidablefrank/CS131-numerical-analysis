function x=backsub(R,w)
//n = 5
//x=zeros(n,1);
//x(n)=b(n)/U(n,n);
    x=zeros(5,1);
    x(5)=w(5)/R(5,5);
    n = 5;
    for j=n-1:-1:1
        i=j+1;
        x(j)=(w(j)-R(j,i:n)*x(i:n))/R(j,j);
    end;
endfunction;

// Data points.
